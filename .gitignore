# Environment and secrets
.env
.env.*
!.env.example

# Credentials
*.pem
*.key
credentials.json
secrets.json

# Editor swap/backup files
*.swp
*.swo
*.tmp
*~

# Temporary logs
*.log

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node / frontend
node_modules/
frontend/dist/
*.tsbuildinfo

# LightGravity runtime data and secret store (must stay out of source control)
bot-data/
secrets/

# LG-031 phase3/phase4 runtime ledger lock (ephemeral, not evidence)
probes/lg031/phase3/ledger/**/*.lock
probes/lg031/phase4/ledger/**/*.lock

# LG-023 phase ledger lock (ephemeral, not evidence)
probes/lg023/ledger/**/*.lock

# LG-032 FAIRNESS-CORRECTION: per-sample frozen seed git object store.
# Regenerable deterministically from fixtures/<sample>/initial + the pinned
# fixtures/<sample>/seed.sha256 (fixed author/committer/date), so only the SHA
# pin is source; the live object store stays out of source control.
probes/lg032/FINAL-COHORT/fixtures/*/seed.git/
