# Optional configuration. Export variables in the shell before starting.
# The application does not automatically load this file.
# Keep real credentials in the protected secret store or process environment.

LIGHTGRAVITY_DATA_DIR=./bot-data
LIGHTGRAVITY_WORKSPACE_ROOT=./bot-data/workspaces
LIGHTGRAVITY_SECRET_STORE=./secrets
LIGHTGRAVITY_HOST=127.0.0.1
LIGHTGRAVITY_PORT=8000
