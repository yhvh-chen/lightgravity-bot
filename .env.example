# LightGravity Bot example configuration.
#
# Copy this file to `.env` and adjust locally. NEVER put real credentials in
# `.env.example` or commit a populated `.env`. Secrets are referenced by name
# from the secret store, not stored here (see docs/08-interface-contract.md §10).
#
# Paths are relative to the process working directory by default, so a cloned
# repository can run without machine-specific absolute paths.

# Runtime data root (gitignored, kept separate from source).
LIGHTGRAVITY_DATA_DIR=./bot-data

# Root under which Task workspaces are authorized.
LIGHTGRAVITY_WORKSPACE_ROOT=./bot-data/workspaces

# Secret store location. Must live outside the repository and Task directories.
LIGHTGRAVITY_SECRET_STORE=./secrets

# Local HTTP bind. Defaults to loopback only.
LIGHTGRAVITY_HOST=127.0.0.1
LIGHTGRAVITY_PORT=8000

# Optional local access token for non-loopback binds (no sample value).
# LIGHTGRAVITY_ACCESS_TOKEN=

# --- LG-020 local startup/distribution (all optional) ---------------------
#
# Extra Host header values accepted in addition to loopback (comma separated).
# Keep this empty for the default loopback-only local service.
# LIGHTGRAVITY_ALLOWED_HOSTS=
#
# Static frontend build served by the same process (default ./frontend/dist).
# LIGHTGRAVITY_FRONTEND_DIST=./frontend/dist
#
# Optional operator-injected runtime token. When unset the process generates a
# random token and hands it to the trusted local page in memory only. Never put
# a real token in this file, the repo, a URL or a log.
# LIGHTGRAVITY_RUNTIME_TOKEN=
#
# Optional capability -> agent refs JSON override for the role catalog
# (default derives from enabled agent resources).
# LIGHTGRAVITY_ROLE_CATALOG={"implementation":["developer"],"verification":["developer"]}
