# LightGravity Bot example configuration.
#
# Copy this file to `.env` and adjust locally. NEVER put real credentials in
# `.env.example` or commit a populated `.env`. Secrets are referenced by name
# from the secret store, not stored here (see docs/08-interface-contract.md §10).
#
# Paths are relative to the process working directory by default, so a cloned
# repository can run without machine-specific absolute paths.

# Runtime data root (gitignored, kept separate from source).
LIGHTGRAVITY_DATA_DIR=./bot-data

# Root under which Task workspaces are authorized.
LIGHTGRAVITY_WORKSPACE_ROOT=./bot-data/workspaces

# Secret store location. Must live outside the repository and Task directories.
LIGHTGRAVITY_SECRET_STORE=./secrets

# Local HTTP bind. Defaults to loopback only.
LIGHTGRAVITY_HOST=127.0.0.1
LIGHTGRAVITY_PORT=8000

# Optional local access token for non-loopback binds (no sample value).
# LIGHTGRAVITY_ACCESS_TOKEN=

# --- LG-020 local startup/distribution (all optional) ---------------------
#
# Extra Host header values accepted in addition to loopback (comma separated).
# Keep this empty for the default loopback-only local service.
# LIGHTGRAVITY_ALLOWED_HOSTS=
#
# Static frontend build served by the same process (default ./frontend/dist).
# LIGHTGRAVITY_FRONTEND_DIST=./frontend/dist
#
# Optional operator-injected runtime token. When unset the process generates a
# random token and hands it to the trusted local page in memory only. Never put
# a real token in this file, the repo, a URL or a log.
# LIGHTGRAVITY_RUNTIME_TOKEN=
#
# Optional capability -> agent refs JSON override for the role catalog
# (default derives from enabled agent resources).
# LIGHTGRAVITY_ROLE_CATALOG={"implementation":["developer"],"verification":["developer"]}

# --- LG-050 shared team mode (default OFF = unchanged single-user) ---------
#
# Team mode is explicit. When unset/false the accounts file is never read and
# every existing single-user endpoint is byte-for-byte unchanged. When on, a
# shared workspace requires login: anonymous business requests are 401, a
# member may collaborate but cannot change settings/credentials (403), and only
# an admin may manage the system. Identity comes from an HttpOnly session
# cookie only; X-LG-Token never grants a team role.
#
# Create accounts first (password is read interactively via getpass, never
# passed on the command line or written to logs):
#   uv run lightgravity user add --username alice --role admin --data-dir ./bot-data
#   uv run lightgravity user add --username bob  --role member --data-dir ./bot-data
#   uv run lightgravity user list --data-dir ./bot-data
# Then start the service with LIGHTGRAVITY_TEAM_MODE=1.
#
# Enable team mode (1/true/yes/on).
# LIGHTGRAVITY_TEAM_MODE=1
# Accounts fact source (default <data_dir>/team/accounts.json, gitignored; must
# not be served by the Files API). Only password salts+hashes are stored.
# LIGHTGRAVITY_TEAM_ACCOUNTS=./bot-data/team/accounts.json
# Server-side session lifetime in seconds (in-memory; a restart requires login).
# LIGHTGRAVITY_TEAM_SESSION_TTL_SECONDS=28800
# Set true only when serving over HTTPS so the session cookie gets Secure.
# LIGHTGRAVITY_TEAM_COOKIE_SECURE=false
# Global message prefix that routes to the existing bot/task path. Plain
# messages are recorded for the team and trigger no model call.
# LIGHTGRAVITY_TEAM_BOT_MENTION=@bot

# --- LG-035 image/PDF OCR (all optional; no LAN default) -------------------
#
# When both base URL and model are set, OCR uses this OpenAI-compatible
# endpoint. When unset, OCR stays disabled and reports capability_unavailable,
# keeping the original file. Do NOT bake a LAN address into the product; set it
# only for a specific deployment/test. Embedding is not OCR.
# LIGHTGRAVITY_OCR_BASE_URL=
# LIGHTGRAVITY_OCR_MODEL=
# Optional bearer token; prefer process env / credential_ref over this file.
# LIGHTGRAVITY_OCR_TOKEN=
# LIGHTGRAVITY_OCR_TIMEOUT_SECONDS=90
# LIGHTGRAVITY_OCR_COLD_TIMEOUT_SECONDS=180
# LIGHTGRAVITY_OCR_MAX_TOKENS=2000
