+"""Area and perimeter helpers for simple shapes.
+
+A shape is a dict with a ``kind`` key.  Supported kinds:
+
+* ``rect``   -- requires ``width`` and ``height``
+* ``circle`` -- requires ``radius``
+
+Any other ``kind`` raises :class:`ValueError`.
+"""
+
+import math
+
+__all__ = ["area", "perimeter"]
 
 
 def area(shape):
-    raise NotImplementedError
+    """Return the area of ``shape``."""
+    kind = shape["kind"]
+    if kind == "rect":
+        return shape["width"] * shape["height"]
+    if kind == "circle":
+        return math.pi * shape["radius"] ** 2
+    raise ValueError(f"unknown shape kind: {kind!r}")
 
 
 def perimeter(shape):
-    raise NotImplementedError
+    """Return the perimeter (circumference for circles) of ``shape``."""
+    kind = shape["kind"]
+    if kind == "rect":
+        return 2 * (shape["width"] + shape["height"])
+    if kind == "circle":
+        return 2 * math.pi * shape["radius"]
+    raise ValueError(f"unknown shape kind: {kind!r}")
