    {
      "name": "create_file",
      "args": {
        "CodeContent": "import sys\nfrom src.slugs import slugify\n\ncases = [\n    (\"Hello World\", \"hello-world\"),\n    (\"Hello, World!\", \"hello-world\"),\n    (\"  Hello   World  \", \"hello-world\"),\n    (\"Foo---Bar\", \"foo-bar\"),\n    (\"Café Déjà Vu\", \"caf-d-j-vu\"),\n    (\"!!!\", \"\"),\n    (\"\", \"\"),\n    (\"ABC123\", \"abc123\"),\n    (\"a_b.c\", \"a-b-c\"),\n    (\"---x---\", \"x\"),\n    (\"Ünïcödé\", \"n-c-d\"),\n    (\"Multiple    spaces\", \"multiple-spaces\"),\n    (\"trailing---\", \"trailing\"),\n    (\"---leading\", \"leading\"),\n    (\"MiXeD CaSe 42\", \"mixed-case-42\"),\n]\n\nfailed = 0\nfor inp, expected in cases:\n    got = slugify(inp)\n    status = \"ok\" if got == expected else \"FAIL\"\n    if got != expected:\n        failed += 1\n    print(f\"{status}: slugify({inp!r}) = {got!r} (expected {expected!r})\")\n\nprint(\"FAILURES:\", failed)\nsys.exit(1 if failed else 0)\n",
        "Description": "Ad-hoc test script verifying slugify edge cases (empty, all punctuation, unicode, collapsing, stripping).",
        "Overwrite": true,
