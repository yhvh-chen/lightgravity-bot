      "args": {
        "CodeContent": "\"\"\"Slug helpers.\"\"\"\n\nimport re\n\n_NON_ALNUM = re.compile(r\"[^a-z0-9]+\")\n\n\ndef slugify(title: str) -> str:\n    \"\"\"Lowercase ``title`` and collapse runs of non-alphanumerics to ``-``.\"\"\"\n    return _NON_ALNUM.sub(\"-\", title.lower()).strip(\"-\")\n",
        "Description": "Implement slugify per spec: lowercase, collapse each run of non [a-z0-9] chars into a single \"-\", then strip leading/trailing hyphens.",
        "Overwrite": true,
        "TargetFile": "/tmp/lightgravity-worktrees/agensh-sdk-corrected-20261015/probes/agensh-orchestration-sdk-corrected/runs/formal/t1_independent__C__r0/staging/r1/w1/src/slugs.py"
      },
