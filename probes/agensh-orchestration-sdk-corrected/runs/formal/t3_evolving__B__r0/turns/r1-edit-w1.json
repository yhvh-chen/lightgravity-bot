      "name": "create_file",
      "args": {
        "CodeContent": "\"\"\"Statistics helpers for computing simple summary measures.\"\"\"\n\n\ndef mean(nums):\n    \"\"\"Return the arithmetic mean of ``nums``.\n\n    Raises ``ValueError`` if ``nums`` is empty.\n    \"\"\"\n    if not nums:\n        raise ValueError(\"mean() arg is an empty sequence\")\n    return sum(nums) / len(nums)\n\n\ndef median(nums):\n    \"\"\"Return the median of ``nums``.\n\n    For an odd-length sequence this is the middle value of the sorted\n    sequence; for an even-length sequence it is the average of the two\n    middle values.  Raises ``ValueError`` if ``nums`` is empty.\n    \"\"\"\n    if not nums:\n        raise ValueError(\"median() arg is an empty sequence\")\n    ordered = sorted(nums)\n    n = len(ordered)\n    mid = n // 2\n    if n % 2 == 1:\n        return ordered[mid]\n    return (ordered[mid - 1] + ordered[mid]) / 2\n",
        "Description": "Implement mean/median per spec, preserving the stub signatures and stdlib-only constraint.",
        "Overwrite": true,
        "TargetFile": "/tmp/lightgravity-worktrees/agensh-sdk-corrected-20261015/probes/agensh-orchestration-sdk-corrected/runs/formal/t3_evolving__B__r0/staging/r1/w1/src/stats.py"
