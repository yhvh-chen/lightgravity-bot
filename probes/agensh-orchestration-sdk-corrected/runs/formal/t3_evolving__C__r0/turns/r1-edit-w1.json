    {
      "name": "create_file",
      "args": {
        "CodeContent": "\"\"\"Statistics helpers.\"\"\"\n\n\ndef mean(nums):\n    \"\"\"Return the arithmetic mean of ``nums``.\n\n    Raises ValueError for an empty sequence.\n    \"\"\"\n    values = list(nums)\n    if not values:\n        raise ValueError(\"mean() requires at least one value\")\n    return sum(values) / len(values)\n\n\ndef median(nums):\n    \"\"\"Return the median of ``nums``.\n\n    Raises ValueError for an empty sequence. For an odd number of values the\n    sorted middle value is returned; for an even number the mean of the two\n    middle values is returned.\n    \"\"\"\n    values = sorted(nums)\n    if not values:\n        raise ValueError(\"median() requires at least one value\")\n    n = len(values)\n    mid = n // 2\n    if n % 2 == 1:\n        return values[mid]\n    return (values[mid - 1] + values[mid]) / 2\n",
        "Description": "Implement mean and median per spec: empty sequences raise ValueError, odd length returns sorted middle, even length returns average of two middles. Sorting into a new list avoids mutating caller input.",
        "Overwrite": true,
        "TargetFile": "/tmp/lightgravity-worktrees/agensh-sdk-corrected-20261015/probes/agensh-orchestration-sdk-corrected/runs/formal/t3_evolving__C__r0/staging/r1/w1/src/stats.py"
      },
