      "args": {
        "CodeContent": "from src.stats import mean, median\n\nassert mean([1, 2, 3]) == 2\nassert mean([1, 3]) == 2\nassert mean([5]) == 5\nassert mean((1, 2, 3)) == 2\ntry:\n    mean([])\n    raise AssertionError(\"mean([]) should raise\")\nexcept ValueError:\n    pass\n\nassert median([1, 2, 3]) == 2\nassert median([3, 1, 2]) == 2\nassert median([1, 2, 3, 4]) == 2.5\nassert median([4, 1, 3, 2]) == 2.5\nassert median([5]) == 5\ntry:\n    median([])\n    raise AssertionError(\"median([]) should raise\")\nexcept ValueError:\n    pass\n\n# no input mutation\nsrc = [3, 1, 2]\nmedian(src)\nassert src == [3, 1, 2], src\n\nprint(\"ALL OK\")\n",
